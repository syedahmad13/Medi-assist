# copy to .env and fill in. Never commit .env.
PORT=3001
# HOST=0.0.0.0   (only if other devices must reach the server; default is localhost only)
TZ=Asia/Kolkata
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/mediassist
JWT_SECRET=change-me-to-a-long-random-string

# staff account created by `npm run seed`
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=change-me-too

# optional: without these the routes return 503 instead of crashing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# optional: without SMTP_URL emails are logged to the console
SMTP_URL=
MAIL_FROM=MediAssist <no-reply@example.com>

# set if you get "querySrv ECONNREFUSED"
DNS_SERVERS=8.8.8.8,1.1.1.1
